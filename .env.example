# Neon connection strings (Dashboard → Connect).
# DATABASE_URL: the POOLED one (hostname contains "-pooler"); used by the app.
# DIRECT_URL:   the DIRECT one (no "-pooler"); used by migrations.
# For local development you can set both to the direct URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Signs session cookies. Generate with: npx auth secret
AUTH_SECRET=""

# Password for the two seeded demo accounts (demo-admin@example.com / demo-evaluator@example.com)
DEMO_PASSWORD=""

# Anthropic API key (console.anthropic.com → API Keys). Server-side only.
ANTHROPIC_API_KEY=""

# Set to "true" on the public deployment: disables account creation.
# PUBLIC_DEMO="true"

# Optional overrides (defaults shown)
# EXTRACT_MODEL="claude-haiku-5-5"
# SCORE_MODEL="claude-sonnet-5-5"
# GLOBAL_USD_PER_DAY="2"              # stop all AI calls once today's estimated spend reaches this
# SCORING_RUNS_PER_USER_PER_DAY="40"  # 8 five-run evaluations
# EXTRACTIONS_PER_USER_PER_DAY="20"
